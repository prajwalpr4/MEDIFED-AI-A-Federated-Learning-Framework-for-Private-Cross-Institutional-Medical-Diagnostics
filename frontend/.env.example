# ============================================================
# MEDIFED AI — Frontend Environment Variables (.env.example)
# ============================================================

# ── Supabase Configuration ───────────────────────────────────
# Obtain these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service role key (for authorized server-side API routes only - never expose on client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── FastAPI ML Microservice URL ──────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Google Gemini API Key (Optional for AI diagnostic impressions) ──
# Get free key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
NEXT_PUBLIC_GEMINI_API_KEY=your-gemini-api-key
